{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:warhammer40k_ai:decision_record",
  "title": "DecisionRecord",
  "type": "object",
  "required": [
    "schema_version",
    "game_id",
    "turn_id",
    "phase",
    "decision_id",
    "decision_type",
    "rules_bundle",
    "rules_bundle_id",
    "descriptor_ids",
    "descriptor_bundle_id",
    "version_adapter_boundary",
    "global_seed",
    "decision_seed",
    "omniscient_state",
    "player_obs_state",
    "candidates",
    "mask",
    "wall_clock_ms",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "turn_id": {
      "type": ["string", "integer"]
    },
    "phase": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "decision_type": {
      "type": "string"
    },
    "request_context": {
      "type": "object",
      "description": "Canonical JSON-safe snapshot of the DecisionRequest context used to produce this record."
    },
    "rules_bundle": {
      "$ref": "#/$defs/RulesBundle"
    },
    "rules_bundle_id": {
      "type": "string"
    },
    "descriptor_ids": {
      "$ref": "#/$defs/DescriptorIds"
    },
    "descriptor_bundle_id": {
      "type": "string"
    },
    "version_adapter_boundary": {
      "$ref": "#/$defs/VersionAdapterBoundary"
    },
    "global_seed": {
      "type": "integer",
      "minimum": 0
    },
    "decision_seed": {
      "type": "integer",
      "minimum": 0
    },
    "omniscient_state": {
      "$ref": "#/$defs/StateBlob"
    },
    "player_obs_state": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StateBlob"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CandidateAction"
      }
    },
    "mask": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "description": "Mask length should match candidates length."
    },
    "chosen_action_id": {
      "type": "string"
    },
    "wall_clock_ms": {
      "type": "integer",
      "minimum": 0
    },
    "time_budget_ms": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "human_action_injected": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean",
      "default": true
    },
    "rejection_reason": {
      "type": "string"
    },
    "invalid_attempt": {
      "$ref": "#/$defs/CandidateAction"
    },
    "relabel_rules_bundle": {
      "$ref": "#/$defs/RulesBundle"
    },
    "relabel_rules_bundle_id": {
      "type": "string"
    },
    "relabel_status": {
      "$ref": "#/$defs/RelabelStatus"
    },
    "relabel_candidate_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RelabelCandidateMapEntry"
      }
    },
    "chosen_action_status_under_relabel": {
      "$ref": "#/$defs/ChosenActionStatusUnderRelabel"
    },
    "relabel_notes": {
      "type": "string"
    }
  },
  "dependentRequired": {
    "relabel_rules_bundle": ["relabel_rules_bundle_id"],
    "relabel_rules_bundle_id": ["relabel_rules_bundle"]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": false
          }
        }
      },
      "then": {
        "required": ["invalid_attempt", "rejection_reason"]
      },
      "else": {
        "required": ["chosen_action_id"]
      }
    },
    {
      "if": {
        "required": ["relabel_status"]
      },
      "then": {
        "required": ["relabel_rules_bundle", "chosen_action_status_under_relabel"]
      }
    }
  ],
  "$defs": {
    "RulesBundle": {
      "type": "object",
      "required": [
        "core_rules_id",
        "rules_commentary_id",
        "mission_pack_id",
        "terrain_pack_id",
        "dataslate_id",
        "points_id",
        "faction_pack_id",
        "detachment_pack_id"
      ],
      "properties": {
        "core_rules_id": {
          "type": "string"
        },
        "rules_commentary_id": {
          "type": "string"
        },
        "mission_pack_id": {
          "type": "string"
        },
        "terrain_pack_id": {
          "type": "string"
        },
        "dataslate_id": {
          "type": "string"
        },
        "points_id": {
          "type": "string"
        },
        "faction_pack_id": {
          "type": "string"
        },
        "detachment_pack_id": {
          "type": "string"
        },
        "rules_bundle_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DescriptorIds": {
      "type": "object",
      "required": [
        "mission_descriptor_id",
        "objective_descriptor_ids",
        "terrain_descriptor_ids",
        "deployment_descriptor_id",
        "army_build_descriptor_id",
        "tool_descriptor_ids"
      ],
      "properties": {
        "mission_descriptor_id": {
          "type": "string"
        },
        "objective_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terrain_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deployment_descriptor_id": {
          "type": "string"
        },
        "army_build_descriptor_id": {
          "type": "string"
        },
        "tool_descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "VersionAdapterBoundary": {
      "type": "object",
      "required": [
        "adapter_family",
        "adapter_version",
        "adapter_id",
        "rules_bundle_id",
        "descriptor_bundle_id",
        "descriptor_ids",
        "conditioning_keys",
        "conditioning_signature"
      ],
      "properties": {
        "adapter_family": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "rules_bundle_id": {
          "type": "string"
        },
        "descriptor_bundle_id": {
          "type": "string"
        },
        "descriptor_ids": {
          "$ref": "#/$defs/DescriptorIds"
        },
        "conditioning_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditioning_signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RelabelStatus": {
      "type": "string",
      "enum": [
        "NOT_RELABELED",
        "RELABELED_LEGAL_SEMANTICALLY_COMPARABLE",
        "RELABELED_LEGAL_VALUE_CHANGED",
        "RELABELED_INVALID_UNDER_TARGET_BUNDLE",
        "RELABELED_MAPPED_TO_ANALOGUE",
        "RELABELED_UNREPRESENTABLE",
        "RELABEL_FAILED"
      ]
    },
    "ChosenActionStatusUnderRelabel": {
      "type": "string",
      "enum": [
        "LEGAL_SEMANTICALLY_COMPARABLE",
        "LEGAL_VALUE_CHANGED",
        "INVALID_UNDER_TARGET_BUNDLE",
        "MAPPED_TO_ANALOGUE",
        "UNREPRESENTABLE",
        "UNKNOWN"
      ]
    },
    "RelabelCandidateMapEntry": {
      "type": "object",
      "properties": {
        "mapped_action_id": {
          "type": "string"
        },
        "mapping_status": {
          "type": "string",
          "enum": [
            "UNCHANGED",
            "VALUE_CHANGED",
            "MAPPED_TO_ANALOGUE",
            "INVALID_UNDER_TARGET_BUNDLE",
            "UNREPRESENTABLE",
            "NOT_FOUND"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CandidateAction": {
      "type": "object",
      "required": ["action_id", "params", "metadata"],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "StateBlobPlayer": {
      "type": "object",
      "required": ["player_id", "name", "command_points", "score"],
      "properties": {
        "player_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "command_points": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        },
        "active_secondary_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discarded_secondary_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_secondary_count": {
          "type": "integer"
        },
        "discarded_secondary_count": {
          "type": "integer"
        },
        "secondary_deck_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DetachmentSelectionState": {
      "type": "object",
      "properties": {
        "selection_id": {
          "type": "string"
        },
        "detachment_type": {
          "type": "string"
        },
        "detachment_points_cost": {
          "type": "integer"
        },
        "label": {
          "type": ["string", "null"]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "AttachmentBindingState": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "bodyguard_entry_id": {
          "type": "string"
        },
        "leader_entry_id": {
          "type": ["string", "null"]
        },
        "support_entry_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "DetachmentPointsSummary": {
      "type": "object",
      "required": ["budget", "spent", "remaining"],
      "properties": {
        "budget": {
          "type": ["integer", "null"]
        },
        "spent": {
          "type": "integer"
        },
        "remaining": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "ArmyBuildPlayerState": {
      "type": "object",
      "required": ["player_id", "player_name", "army_present"],
      "properties": {
        "player_id": {
          "type": "string"
        },
        "player_name": {
          "type": "string"
        },
        "army_present": {
          "type": "boolean"
        },
        "army_id": {
          "type": "string"
        },
        "faction": {
          "type": "string"
        },
        "faction_id": {
          "type": "string"
        },
        "points_limit": {
          "type": "integer"
        },
        "battle_size": {
          "type": "string"
        },
        "primary_detachment_type": {
          "type": "string"
        },
        "detachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DetachmentSelectionState"
          }
        },
        "unit_entries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "enhancement_assignments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "attachment_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachmentBindingState"
          }
        },
        "detachment_points_summary": {
          "$ref": "#/$defs/DetachmentPointsSummary"
        },
        "force_disposition": {
          "type": "string"
        },
        "allowed_force_dispositions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_metadata": {
          "type": "object"
        },
        "blueprint_metadata": {
          "type": "object"
        },
        "validated_muster": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ArmyBuildState": {
      "type": "object",
      "required": ["army_build_descriptor_id", "players"],
      "properties": {
        "army_build_descriptor_id": {
          "type": "string"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArmyBuildPlayerState"
          }
        }
      },
      "additionalProperties": false
    },
    "ObjectiveGeometry": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "control_radius": {
          "type": "number"
        },
        "footprint": {
          "type": ["object", "null"]
        },
        "feature_key": {
          "type": "string"
        },
        "feature_label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ControlRegionState": {
      "type": "object",
      "required": ["region_id", "kind"],
      "properties": {
        "region_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "objective_id": {
          "type": "string"
        },
        "objective_site_id": {
          "type": "string"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "radius": {
          "type": "number"
        },
        "footprint": {
          "type": ["object", "null"]
        },
        "feature_key": {
          "type": "string"
        },
        "feature_label": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "ScoreSourceState": {
      "type": "object",
      "required": ["score_source_id", "kind"],
      "properties": {
        "score_source_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "objective_id": {
          "type": "string"
        },
        "objective_site_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "controller_player_id": {
          "type": "string"
        },
        "points_value": {
          "type": "integer"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "ObjectiveStateEntry": {
      "type": "object",
      "required": [
        "objective_id",
        "objective_site_id",
        "site_kind",
        "geometry",
        "control_region",
        "score_sources"
      ],
      "properties": {
        "objective_id": {
          "type": "string"
        },
        "objective_site_id": {
          "type": "string"
        },
        "site_kind": {
          "type": "string"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "control_radius": {
          "type": "number"
        },
        "controller_player_id": {
          "type": "string"
        },
        "sticky_controller_player_id": {
          "type": "string"
        },
        "removed": {
          "type": "boolean"
        },
        "geometry": {
          "$ref": "#/$defs/ObjectiveGeometry"
        },
        "control_region": {
          "$ref": "#/$defs/ControlRegionState"
        },
        "score_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreSourceState"
          }
        }
      },
      "additionalProperties": true
    },
    "StateBlob": {
      "description": "Canonicalized replay/telemetry state payload.",
      "type": "object",
      "required": [
        "state_blob_version",
        "rules_bundle",
        "battle_round",
        "phase",
        "active_player_id",
        "players",
        "army_build_state",
        "mission_state",
        "deployment_state",
        "objectives",
        "scoring_surfaces",
        "control_regions",
        "terrain",
        "units"
      ],
      "properties": {
        "state_blob_version": {
          "type": "string"
        },
        "rules_bundle": {
          "$ref": "#/$defs/RulesBundle"
        },
        "battle_round": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "active_player_id": {
          "type": "string"
        },
        "viewer_player_id": {
          "type": "string"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateBlobPlayer"
          }
        },
        "army_build_state": {
          "$ref": "#/$defs/ArmyBuildState"
        },
        "mission_state": {
          "type": "object"
        },
        "deployment_state": {
          "type": "object"
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectiveStateEntry"
          }
        },
        "scoring_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoreSourceState"
          }
        },
        "control_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlRegionState"
          }
        },
        "terrain": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "Outcome": {
      "type": "object",
      "properties": {
        "immediate_deltas": {
          "type": "object"
        },
        "end_of_turn_return": {
          "type": "number"
        },
        "end_of_game_return": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
