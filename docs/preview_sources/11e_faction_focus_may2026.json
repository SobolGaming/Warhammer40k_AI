  "pr_015_assumption_checklist": [
    {
      "mechanic": "detection_marker",
      "release_day_action": "Confirm final terminology, duration, stacking, target visibility requirement, and whether marker labels remain mechanically equivalent."
    },
    {
      "mechanic": "hidden_preserving_shooting",
      "release_day_action": "Confirm which shooting events break Hidden, which exemptions preserve it, and whether exemption timing is phase-scoped or turn-scoped."
    },
    {
      "mechanic": "attack_scoped_detection_range_delta",
      "release_day_action": "Confirm whether while-shooting detection changes apply only to the active attacking unit or create wider visibility for other units."
    },
    {
      "mechanic": "cleave",
      "release_day_action": "Confirm Select Targets timing, target model-count snapshot semantics, and interaction with split-fire weapon allocation."
    },
    {
      "mechanic": "updated_heavy",
      "release_day_action": "Confirm set-up-this-turn and model-move-distance provenance requirements for the final keyword text."
    },
    {
      "mechanic": "mobile",
      "release_day_action": "Confirm terrain traversal permissions and whether mounted units receive a common movement keyword or faction-specific text."
    },
    {
      "mechanic": "upgrade_assignment",
      "release_day_action": "Confirm target kinds, target cardinality, per-target points costs, weapon-profile selection timing, and enhancement-budget accounting."
    },
    {
      "mechanic": "reactive_move",
      "release_day_action": "Confirm trigger windows, movement kind, destination policy, and whether reserve-exit effects use normal Strategic Reserves state."
    },
    {
      "mechanic": "heroic_intervention_modes",
      "release_day_action": "Confirm mode ids, CP deltas, target policies, repeat-use exceptions, and per-unit/per-phase limits."
    },
    {
      "mechanic": "must_fight_next",
      "release_day_action": "Confirm fight scheduler priority when multiple Fights First or must-fight-next constraints coexist."
    },
    {
      "mechanic": "battle_shock_persistence",
      "release_day_action": "Confirm Command phase clearing procedure and whether a Leadership test or other action removes battle-shock."
    }
  ]
}
